# ==============================================================================
# Konfigurasi Host Nginx Reverse Proxy untuk Domain elearning.socket-clenicapp.my.id
# Letakkan file ini di VPS: /etc/nginx/sites-available/elearning.socket-clenicapp.my.id
# ==============================================================================

server {
    listen 80;
    server_name elearning.socket-clenicapp.my.id;

    # Forward traffic ke Docker Frontend Container port 8080
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # WebSockets support (jika diperlukan)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    client_max_body_size 50M;
}

# CATATAN:
# Setelah mengaktifkan konfigurasi ini, cukup jalankan:
# sudo certbot --nginx -d elearning.socket-clenicapp.my.id
# Certbot akan otomatis menginjeksi blok listen 443 ssl dan sertifikat Let's Encrypt!
