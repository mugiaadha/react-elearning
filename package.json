{
  "name": "elearning-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"FE,BE,QUEUE\" -c \"blue,green,yellow\" \"npm run dev:fe\" \"npm run dev:be\" \"npm run dev:queue\"",
    "dev:fe": "vite",
    "dev:be": "cd backend && php artisan serve",
    "dev:queue": "cd backend && php artisan queue:listen --tries=2 --backoff=1800",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.56.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.2.5",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.17",
    "vite": "^8.3.0"
  }
}
