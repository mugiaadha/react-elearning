# NAC Tax Center - Environment Blueprint for Backend & DevOps
# In Mock Mode: leave VITE_USE_MOCK_API=true and VITE_API_BASE_URL empty (calls /public/api/*.json)
# In Real BE Mode: set VITE_USE_MOCK_API=false and provide real backend URL (e.g. https://api.nactaxcenter.id)
VITE_API_BASE_URL=https://api.nactaxcenter.id
VITE_USE_MOCK_API=false
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Development / Simulator Mode (set to 'false' for production look, 'true' to show RBAC switcher & quick presets)
DEV_MODE=false
VITE_DEV_MODE=false
