# NAC Tax Center - Frontend Environment Configuration
# API Base URL (Production Domain)
VITE_API_BASE_URL=/api

# Google OAuth 2.0 Web Client ID
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Development / Simulator Mode (set 'false' for production, 'true' to show RBAC switcher & instant presets)
VITE_DEV_MODE=false

# Midtrans Payment Gateway Client Key (Sandbox / Production)
VITE_MIDTRANS_CLIENT_KEY=your-midtrans-client-key
